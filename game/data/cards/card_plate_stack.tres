[gd_resource type="Resource" script_class="EvidenceCard" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/data/evidence_card.gd" id="1_card"]

[resource]
script = ExtResource("1_card")
id = "card_plate_stack"
title = "五张底片同点"
body = "五张底片来自五个不同港口，船期相隔十一年。灯下一叠，银盐里的岸线竟落在同一个点。底片边缘还有一顶礼帽的剪影——比岸线更清楚，像有人一直站在取景框外。"
voice = "evidence"
weight = 15
unlocks_entry_id = "entry_plate_stack"
